---
interface Props {
  name: string;
  id: string;
  images: { src: string; alt: string }[];
  eager?: boolean;
}
const { name, id, images, eager = false } = Astro.props;
---

<project-gallery role="group" aria-label={`${name} screenshots`} aria-roledescription={images.length > 1 ? 'carousel' : undefined}>
  <div class="slides" id={`${id}-screenshots`}>
    {images.map((image, index) => (
      <img src={image.src} alt={image.alt} width="960" height="540" loading={eager && index === 0 ? 'eager' : 'lazy'} decoding="async" hidden={index !== 0} />
    ))}
  </div>
  {images.length > 1 && (
    <div class="gallery-controls" hidden>
      <button type="button" data-direction="-1" aria-label={`Previous screenshot for ${name}`} aria-controls={`${id}-screenshots`}>
        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m14 6-6 6 6 6" /></svg>
      </button>
      <span class="gallery-count" aria-live="polite" aria-atomic="true"><span class="sr-only">Screenshot </span><span data-count>1 / {images.length}</span></span>
      <button type="button" data-direction="1" aria-label={`Next screenshot for ${name}`} aria-controls={`${id}-screenshots`}>
        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m10 6 6 6-6 6" /></svg>
      </button>
    </div>
  )}
</project-gallery>

<script>
  class ProjectGallery extends HTMLElement {
    connectedCallback() {
      if (this.dataset.initialized) return;
      this.dataset.initialized = 'true';
      const images = Array.from(this.querySelectorAll<HTMLImageElement>('img'));
      if (images.length < 2) return;
      const controls = this.querySelector<HTMLElement>('.gallery-controls')!;
      const count = this.querySelector<HTMLElement>('[data-count]')!;
      const slides = this.querySelector<HTMLElement>('.slides')!;
      let current = 0;
      const show = (index: number) => {
        current = (index + images.length) % images.length;
        // Begin loading before revealing a previously hidden, lazy image.
        images[current].loading = 'eager';
        images.forEach((image, i) => { image.hidden = i !== current; });
        count.textContent = `${current + 1} / ${images.length}`;
      };
      controls.hidden = false;
      this.tabIndex = 0;
      // Fetch alternate screenshots when their card is near the viewport so
      // switching slides doesn't briefly reveal an empty image.
      const observer = new IntersectionObserver((entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        images.forEach((image) => { image.loading = 'eager'; });
        observer.disconnect();
      }, { rootMargin: '200px' });
      observer.observe(this);
      this.querySelectorAll<HTMLButtonElement>('[data-direction]').forEach((button) => {
        button.addEventListener('click', () => show(current + Number(button.dataset.direction)));
      });
      this.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft') show(current - 1);
        else if (event.key === 'ArrowRight') show(current + 1);
        else if (event.key === 'Home') show(0);
        else if (event.key === 'End') show(images.length - 1);
        else return;
        event.preventDefault();
      });
      let start: { x: number; y: number; id: number } | undefined;
      slides.addEventListener('pointerdown', (event) => {
        if (event.pointerType === 'mouse') return;
        start = { x: event.clientX, y: event.clientY, id: event.pointerId };
        slides.setPointerCapture(event.pointerId);
      });
      slides.addEventListener('pointerup', (event) => {
        if (!start || event.pointerId !== start.id) return;
        const dx = event.clientX - start.x;
        const dy = event.clientY - start.y;
        if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy) * 1.2) show(current + (dx < 0 ? 1 : -1));
        start = undefined;
      });
      slides.addEventListener('pointercancel', () => { start = undefined; });
    }
  }
  if (!customElements.get('project-gallery')) customElements.define('project-gallery', ProjectGallery);
</script>

<style>
  project-gallery { display: block; position: relative; background: #101014; border-bottom: 1px solid var(--border); }
  project-gallery:focus-visible { outline: 2px solid #a78bfa; outline-offset: -3px; }
  .slides { display: grid; aspect-ratio: 16 / 9; overflow: hidden; touch-action: pan-y pinch-zoom; }
  img { display: block; width: 100%; height: 100%; min-height: 0; object-fit: contain; }
  img[hidden], .gallery-controls[hidden] { display: none; }
  .gallery-controls { position: absolute; bottom: 10px; right: 10px; display: flex; align-items: center; gap: 2px; padding: 2px; border: 1px solid #ffffff30; border-radius: 7px; background: #101014e8; color: #fff; }
  button { display: grid; place-items: center; width: 32px; height: 32px; cursor: pointer; border-radius: 4px; }
  button:hover { background: #ffffff20; }
  button:focus-visible { outline: 2px solid #c4b5fd; outline-offset: -2px; }
  .gallery-count { min-width: 38px; text-align: center; font-size: 11px; font-variant-numeric: tabular-nums; }
</style>
