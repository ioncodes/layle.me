---
import '../../styles/gx-demos.css';

interface Props {
  before: string;
  after: string;
  beforeAlt: string;
  afterAlt: string;
  beforeLabel?: string;
  afterLabel?: string;
  comparisonLabel?: string;
  caption?: string;
  zoom?: { label: string; origin: string };
  width?: number;
  height?: number;
}
const { before, after, beforeAlt, afterAlt, beforeLabel = 'Before', afterLabel = 'After', comparisonLabel = 'Compare the original and fixed frames', caption, zoom, width = 640, height = 448 } = Astro.props;
---

<gx-image-comparison class="gx-demo not-prose" data-before-label={beforeLabel} data-after-label={afterLabel} style={zoom ? `--comparison-origin: ${zoom.origin}` : undefined}>
  <figure>
    <div class="gx-comparison">
      <img src={after} alt={afterAlt} width={width} height={height} loading="lazy" />
      <div class="gx-before"><img src={before} alt={beforeAlt} width={width} height={height} loading="lazy" /></div>
      <div class="gx-divider" aria-hidden="true"></div>
    </div>
    <fieldset class="gx-comparison-controls" disabled>
      <div class="gx-comparison-slider">
        <input type="range" min="0" max="100" value="50" data-reveal aria-label={comparisonLabel} />
        <div class="gx-comparison-labels" aria-hidden="true"><span>{beforeLabel}</span><span>{afterLabel}</span></div>
      </div>
      {zoom && <label><input type="checkbox" data-zoom-toggle /> {zoom.label}</label>}
    </fieldset>
    {caption && <figcaption class="gx-comparison-caption">{caption}</figcaption>}
    <noscript><p><a href={before}>{beforeLabel}</a> / <a href={after}>{afterLabel}</a></p></noscript>
  </figure>
</gx-image-comparison>

<script>
  class ImageComparison extends HTMLElement {
    connectedCallback() {
      const range = this.querySelector<HTMLInputElement>('[data-reveal]')!;
      const before = this.querySelector<HTMLElement>('.gx-before')!;
      const divider = this.querySelector<HTMLElement>('.gx-divider')!;
      const comparison = this.querySelector<HTMLElement>('.gx-comparison')!;
      const update = () => {
        before.style.clipPath = `inset(0 ${100 - Number(range.value)}% 0 0)`;
        divider.style.left = `${range.value}%`;
        this.style.setProperty('--comparison-position', `${range.value}%`);
        range.setAttribute('aria-valuetext', `${range.value}% ${this.dataset.beforeLabel!.toLowerCase()}, ${100 - Number(range.value)}% ${this.dataset.afterLabel!.toLowerCase()}`);
        comparison.toggleAttribute('data-zoom', this.querySelector<HTMLInputElement>('[data-zoom-toggle]')?.checked ?? false);
      };
      this.oninput = update;
      this.querySelector('fieldset')!.disabled = false;
      update();
    }
  }
  customElements.define('gx-image-comparison', ImageComparison);
</script>
