---
import Math from '../Math.astro';

const steps = [
  { corner: '(0, 0, 0.20)', equations: ['C = 0.20'] },
  {
    corner: '(100, 0, 0.30)',
    equations: ['100A + 0.20 = 0.30', String.raw`A = \dfrac{0.30 - 0.20}{100} = 0.001`],
  },
  {
    corner: '(0, 100, 0.40)',
    equations: ['100B + 0.20 = 0.40', String.raw`B = \dfrac{0.40 - 0.20}{100} = 0.002`],
  },
];
---

<div class="plane-derivation not-prose">
  <dl>
    {steps.map(({ corner, equations }) => (
      <div class="step">
        <dt><Math tex={corner} /></dt>
        <dd>{equations.map(equation => <div><Math tex={equation} /></div>)}</dd>
      </div>
    ))}
  </dl>
  <div class="result"><Math tex={String.raw`\operatorname{depth}(x,y) = 0.001x + 0.002y + 0.20`} /></div>
</div>

<style>
  .plane-derivation { margin: 2rem 0; font-size: 1rem; color: var(--foreground); }
  dl { display: grid; gap: 1.75rem; max-width: 36rem; margin: 0 auto; }
  .step { display: grid; grid-template-columns: 11rem minmax(0, 1fr); align-items: start; gap: 1.5rem; line-height: 2; }
  dt { color: var(--muted-foreground); }
  dd { display: grid; gap: .5rem; margin: 0; text-align: left; }
  .result { margin-top: 2rem; text-align: center; line-height: 2; text-wrap: balance; }
  @media (max-width: 620px) {
    .plane-derivation { font-size: .95rem; }
    .step { grid-template-columns: minmax(0, 1fr); gap: .65rem; text-align: center; }
    dd { width: fit-content; margin-inline: auto; }
    .result { font-size: .9rem; }
  }
</style>
