---
import {
  Card,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";
import type { CollectionEntry } from "astro:content";

export interface Props {
  post: CollectionEntry<'posts'>;
  isSticky?: boolean;
}

const { post, isSticky = false } = Astro.props;
---

<a href={`/posts/${post.id}`} class="block group">
  <Card
    className="transition-all duration-200 hover:shadow-lg hover:scale-[1.02] cursor-pointer relative overflow-hidden gap-0 py-0 sm:flex-row"
  >
    <div class:list={[
      "relative aspect-[2/1] shrink-0 overflow-hidden sm:aspect-auto sm:w-52",
      post.data.image.fit === 'contain' ? 'bg-white' : 'bg-muted',
    ]}>
      <img
        src={post.data.image.src}
        alt=""
        width="640"
        height="448"
        loading="lazy"
        decoding="async"
        class:list={['absolute inset-0 h-full w-full', { 'p-6': post.data.image.fit === 'contain' }]}
        style={{ objectFit: post.data.image.fit, objectPosition: post.data.image.position }}
      />
    </div>
    <CardHeader className="min-w-0 flex-1 p-6">
      <div class="flex items-start justify-between gap-3">
        <CardTitle className="group-hover:text-violet-400 transition-colors text-xl">
          {post.data.title || "Untitled"}
        </CardTitle>
        {isSticky && <Badge variant="secondary">Pinned</Badge>}
      </div>
      {
        post.data.summary && (
          <CardDescription>{post.data.summary}</CardDescription>
        )
      }
      {
        post.data.date && (
          <CardDescription className="text-sm text-gray-500">
            {new Date(post.data.date).toLocaleDateString("en-US", {
              year: "numeric",
              month: "long",
              day: "numeric",
            })}
            · {post.data.author}
          </CardDescription>
        )
      }
      {
        post.data.tags && post.data.tags.length > 0 && (
          <div class="flex flex-wrap gap-2 mt-2">
            {post.data.tags.map((tag: string) => (
              <Badge variant="outline">{tag}</Badge>
            ))}
          </div>
        )
      }
    </CardHeader>
  </Card>
</a>
