---
import type { CollectionEntry } from 'astro:content';
import { Code } from 'astro:components';
import ProjectGallery from './ProjectGallery.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { data } = project;
---

<article class="project-card">
  {data.images.length > 0 ? (
    <ProjectGallery name={data.name} id={project.id} images={data.images} eager={project.id === 'sly' || project.id === 'gecko'} />
  ) : data.code && (
    <div class="code-preview" aria-label={`${data.name} code example`}>
      <Code code={data.code.text} lang={data.code.language} themes={{ light: 'github-light-default', dark: 'github-dark-default' }} />
    </div>
  )}
  <a href={data.website ?? data.url} target="_blank" rel="noopener noreferrer">
    <div class="project-copy">
      <div class="project-title">
        <h2>{data.name}</h2>
        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M7 7h10v10" /></svg>
      </div>
      <p>{data.description}</p>
      <div class="project-tags"><span>{data.language}</span><span>{data.category}</span></div>
    </div>
  </a>
</article>

<style>
  .project-card { display: flex; flex-direction: column; min-width: 0; border: 1px solid var(--border); border-radius: var(--radius); background: var(--card); overflow: hidden; transition: border-color 180ms; }
  a { display: flex; flex-direction: column; flex: 1; }
  .project-card:has(a:focus-visible) { outline: 2px solid var(--ring); outline-offset: 3px; }
  a:focus-visible { outline: none; }
  .code-preview { display: grid; align-items: center; aspect-ratio: 16 / 9; overflow: auto; border-bottom: 1px solid var(--border); background: var(--muted); }
  .code-preview :global(pre) { margin: 0; padding: 16px; font-size: 11px; line-height: 1.7; }
  :global(.dark) .code-preview { background: #0d1117; }
  .project-copy { display: flex; flex-direction: column; flex: 1; padding: 20px; }
  .project-title { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 8px; }
  h2 { font-size: 20px; font-weight: 600; line-height: 1.3; }
  svg { flex-shrink: 0; color: var(--muted-foreground); }
  p { color: var(--muted-foreground); font-size: 14px; line-height: 1.65; margin-bottom: 16px; }
  .project-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: auto; }
  .project-tags span { border: 1px solid var(--border); border-radius: 5px; padding: 2px 8px; font-size: 11px; font-weight: 500; }
  .project-card:hover { border-color: #a78bfa; }
  a:hover h2 { color: #7c3aed; }
  :global(.dark) a:hover h2 { color: #c4b5fd; }
  @media (prefers-reduced-motion: reduce) { .project-card { transition: none; } }
</style>
