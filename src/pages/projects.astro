---
import '../styles/global.css';
import Navbar from '@/components/Navbar.astro';
import Footer from '@/components/Footer.astro';
import ThemeScript from '@/components/ThemeScript.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const description = 'Emulators, debugging tools, and libraries. A selection of open-source projects by Layle.';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="alternate" type="application/rss+xml" title="Layle's Lair" href="/rss.xml" />
    <title>Projects - Layle's Lair</title>
    <meta name="description" content={description} />
    <meta property="og:title" content="Projects - Layle's Lair" />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:site_name" content="Layle's Lair" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Projects - Layle's Lair" />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:creator" content="@layle_ctf" />
    <ThemeScript />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to projects</a>
    <Navbar />

    <main id="main" class="max-w-4xl mx-auto px-4 py-8">
      <h1 class="text-4xl font-bold mb-6">Projects</h1>
      <p class="text-lg text-muted-foreground mb-10">
        A selection of my open-source projects, usually related to reverse
        engineering, emulation, or security research.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>

      <div class="mt-10 text-center">
        <a
          href="https://github.com/ioncodes?tab=repositories"
          target="_blank"
          rel="noopener noreferrer"
          class="text-violet-600 dark:text-violet-400 hover:underline underline-offset-4"
        >View all projects on GitHub <span aria-hidden="true">&#8599;&#65038;</span></a>
      </div>
    </main>
    <Footer />
  </body>
</html>

<style>
  .skip-link { position: fixed; top: -80px; left: 16px; padding: 12px 20px; z-index: 100; background: var(--background); border: 1px solid var(--border); }
  .skip-link:focus { top: 12px; }
</style>
